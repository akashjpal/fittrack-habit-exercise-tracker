# ============================================
# FitTrack Server Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS). The FIRST entry also doubles as the client app origin
# that GET /oauth/authorize redirects the browser to for login/consent.
CLIENT_URL=http://localhost:5173,https://yourdomain.com

# Canonical public URL of this server (used to build OAuth issuer/metadata URLs).
# Must be set explicitly in production — not inferred from request headers.
PUBLIC_URL=https://your-server-domain.example.com

# InsForge Configuration
INSFORGE_BASE_URL=https://your-project.insforge.app
INSFORGE_ANON_KEY=your_insforge_anon_key_here
INSFORGE_SERVICE_KEY=your_insforge_service_key_here

# Groq AI (for AI features + voice transcription)
GROQ_API_KEY=your_groq_api_key_here
